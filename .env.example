DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-this-in-production-minimum-50-chars-long
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# SQLite fallback default for quick local run without docker:
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in docker-compose:
# DATABASE_URL=postgres://edital_user:edital_pass@localhost:5432/edital_db

# Auth integration mode: 'local' (development) or 'microsoft' (institutional)
AUTH_ADAPTER=local

# === Microsoft Entra ID (Azure AD) / MSAL ===
# Só é usado quando AUTH_ADAPTER=microsoft.
# Pegue estes valores no portal do Azure: Entra ID > App registrations > seu app.
MS_CLIENT_ID=              # "Application (client) ID"
MS_TENANT_ID=             # "Directory (tenant) ID"
MS_CLIENT_SECRET=         # Certificates & secrets > New client secret (o VALUE, não o Secret ID)
# Opcionais (têm default sensato):
# MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback/
# MS_AUTHORITY=https://login.microsoftonline.com/<MS_TENANT_ID>
# MS_SCOPES=User.Read

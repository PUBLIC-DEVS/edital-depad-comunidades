DEBUG=True
SECRET_KEY=django-insecure-local-dev-key-change-this-in-production-minimum-50-chars-long
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# SQLite fallback default for quick local run without docker:
DATABASE_URL=sqlite:///db.sqlite3
# For PostgreSQL in docker-compose:
# DATABASE_URL=postgres://edital_user:edital_pass@localhost:5432/edital_db

# Auth integration mode: 'local' (development) or 'microsoft' (institutional)
AUTH_ADAPTER=local
